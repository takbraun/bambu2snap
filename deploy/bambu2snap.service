[Unit]
Description=bambu2snap server
After=network.target
# Si falla 5 veces en 2 minutos, deja de reintentar en vez de entrar en bucle infinito
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Cierra cualquier copia vieja de bambu2snap que siga ocupando el puerto 8080
ExecStartPre=-/usr/bin/pkill -u %u -f "uvicorn main:app --host 0.0.0.0 --port 8080"
ExecStartPre=/bin/sleep 1
ExecStart=/bin/bash %h/bambu2snap/start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
